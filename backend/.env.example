MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=emergent_meeting
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@roombook.com
ADMIN_PASSWORD=Admin@123
CORS_ORIGINS=http://localhost:3001,http://YOUR-LAPTOP-IP:3001
APP_HOST=0.0.0.0
APP_PORT=8000
UVICORN_RELOAD=false
APP_PUBLIC_URL=http://localhost:3001
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_DEV_MODE=false
# Meeting approvals and password-reset emails are sent through Resend.
SUPERVISOR_EMAIL_PROVIDER=resend
PASSWORD_RESET_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM=GASS <no-reply-booking@kcsi.id>
USER_APPROVAL_ADMIN_EMAILS=admin@kcsi.id
# SMTP remains available as a fallback provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
