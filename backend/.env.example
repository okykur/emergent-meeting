POSTGRES_DSN=postgresql://gass_mirror:change-me@127.0.0.1:5432/GASS
# Legacy rollback/migration settings. The application runtime does not use MongoDB.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=emergent_meeting
POSTGRES_MIRROR_DSN=postgresql://gass_mirror:change-me@127.0.0.1:5432/GASS
MIRROR_COLLECTIONS=
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@roombook.com
ADMIN_PASSWORD=Admin@123
CORS_ORIGINS=http://localhost:3001,http://YOUR-LAPTOP-IP:3001
APP_HOST=0.0.0.0
APP_PORT=8000
UVICORN_RELOAD=false
APP_PUBLIC_URL=http://localhost:3001
APP_TIMEZONE=Asia/Jakarta
MEETING_REMINDERS_ENABLED=true
MEETING_REMINDER_SCAN_SECONDS=60
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_DEV_MODE=false
# Meeting approvals and password-reset emails are sent through Resend.
SUPERVISOR_EMAIL_PROVIDER=resend
PASSWORD_RESET_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM=GASS <no-reply-booking@kcsi.id>
USER_APPROVAL_ADMIN_EMAILS=admin@kcsi.id
# WhatsApp trial notifications. Keep the API key only in the runtime .env.
WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_BASE_URL=http://10.0.29.47:9009/api/v1
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_PROVIDER=eva
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=10
# SMTP remains available as a fallback provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
